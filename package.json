{
  "name": "chai-aur-docker-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Chai aur Docker — a practical Docker book by Hitesh, with a live lab. Entirely on your machine.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "postinstall": "node -e \"try{const fs=require('fs');fs.readdirSync('node_modules/node-pty/prebuilds').forEach(d=>{const p='node_modules/node-pty/prebuilds/'+d+'/spawn-helper';if(fs.existsSync(p))fs.chmodSync(p,0o755)})}catch(e){}\"",
    "test-all": "bash instructor/test-all.sh",
    "clean": "bash scripts/clean-all.sh",

  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.21.0",
    "marked": "^12.0.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
