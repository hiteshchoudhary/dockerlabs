# Chapter 28 — reverse proxy config TEMPLATE.
#
# This file is committed scaffolding — don't edit it. Make your working copy:
#     cp ch28/nginx.conf.template ch28/nginx.conf
# and mount the COPY into the proxy container at /etc/nginx/conf.d/default.conf
#
# An "upstream" is a named pool of backends. nginx round-robins across the
# pool by default — the container names below resolve via Docker's DNS,
# so this only works on a user-defined network (chai-28-net).

upstream chai_api {
    server chai-28-api1:3000;
    server chai-28-api2:3000;
}

server {
    listen 80;

    location / {
        proxy_pass http://chai_api;
        # forward the truth about the original request:
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # CHALLENGE hint: nginx can answer some paths ITSELF — no upstream trip.
    # A location block with a plain `return` is served straight from the proxy:
    #
    # location /health {
    #     return 200 "ok\n";
    # }
}
